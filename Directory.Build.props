<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>

    <Product>Clipboard Manager</Product>
    <!-- Release builds pass -p:Version from the tag; this is the version of local builds. -->
    <Version>0.10.0</Version>
    <Company>Secoolioo</Company>
    <Authors>Secoolioo</Authors>
    <Copyright>Copyright (C) 2026 Secoolioo and contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Secoolioo/clipboard-manager</RepositoryUrl>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>

    <!-- Reproducible, privacy-safe builds: never embed local paths, also for local builds. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>

    <!-- Locked, reproducible restores. Every project declares both release RIDs so the lock files
         are identical whether restored for build, test or a RID-specific publish. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
