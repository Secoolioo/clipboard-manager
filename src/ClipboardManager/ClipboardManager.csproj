<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ClipboardManager</AssemblyName>
    <RootNamespace>ClipboardManager</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\..\assets\brand\app.ico')">..\..\assets\brand\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <Description>Fast, private clipboard history for Windows.</Description>
  </PropertyGroup>

  <!-- Release artifact: one self-contained EXE. Uncompressed on purpose: compressed bundles are
       inflated into private memory (+70 MB measured), which matters for an always-running app. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows gets solid, themed backgrounds instead of Fluent's automatic Mica. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
    <!-- Small heaps: 1 MB GC regions cut native GC bookkeeping. -->
    <RuntimeHostConfigurationOption Include="System.GC.RegionSize" Value="1048576" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipboardManager.Core\ClipboardManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GPLv3 §5(d): the app shows its license and the third-party notices (Settings > About). -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClipboardManager.Tests" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
