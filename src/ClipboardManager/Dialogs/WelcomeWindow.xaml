<Window x:Class="ClipboardManager.Dialogs.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClipboardManager.Localization"
        x:ClassModifier="internal"
        Title="{x:Static loc:Strings.AppName}"
        SizeToContent="Height" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <StackPanel Margin="28,24,28,22">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <Image x:Name="Logo" Width="44" Height="44" Margin="0,0,14,0" />
      <TextBlock Text="{x:Static loc:Strings.WelcomeTitle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="{x:Static loc:Strings.WelcomeIntro}" TextWrapping="Wrap" Margin="0,0,0,14"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

    <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="TryText" FontSize="15" TextWrapping="Wrap" />
        <TextBlock x:Name="HotkeyWarning" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
      </StackPanel>
    </Border>

    <CheckBox x:Name="Autostart" Content="{x:Static loc:Strings.StartWithWindows}" Margin="0,0,0,6" />
    <TextBlock x:Name="LocationHint" TextWrapping="Wrap" Margin="28,0,0,8" FontSize="12" Visibility="Collapsed"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <CheckBox x:Name="StartMenu" Content="{x:Static loc:Strings.ShowInStartMenu}" Margin="0,0,0,14" />

    <TextBlock Text="{x:Static loc:Strings.WelcomeTray}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,6"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <TextBlock Margin="0,0,0,18">
      <Hyperlink Click="OnTaskbarSettings"><Run Text="{x:Static loc:Strings.WelcomeTaskbarSettings}" /></Hyperlink>
    </TextBlock>

    <Button Content="{x:Static loc:Strings.WelcomeDone}" HorizontalAlignment="Right" MinWidth="120" IsDefault="True"
            Style="{DynamicResource AccentButtonStyle}" Click="OnDone" />
  </StackPanel>
</Window>
