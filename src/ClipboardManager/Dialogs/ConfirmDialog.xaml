<Window x:Class="ClipboardManager.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        SizeToContent="Height" Width="440" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <CheckBox x:Name="Option" Visibility="Collapsed" Margin="0,0,0,12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="ConfirmButton" MinWidth="110" Margin="0,0,8,0" Click="OnConfirm" Style="{DynamicResource AccentButtonStyle}" />
      <Button x:Name="CancelButton" MinWidth="110" IsCancel="True" IsDefault="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
