<Window x:Class="ClipboardManager.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClipboardManager.Localization"
        x:ClassModifier="internal"
        Title="{x:Static loc:Strings.SettingsTitle}"
        Width="640" Height="760" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,22,0,8" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="28,2,0,10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Row" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,6,28,28">
      <TextBlock Text="{x:Static loc:Strings.SettingsTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,14,0,0" />

      <!-- General -->
      <TextBlock Style="{StaticResource Section}" Text="{x:Static loc:Strings.SectionGeneral}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox x:Name="AutostartBox" Style="{StaticResource Row}" Content="{x:Static loc:Strings.StartWithWindows}" Click="OnAutostartClick" />
          <TextBlock x:Name="AutostartNote" Style="{StaticResource Note}" Visibility="Collapsed" />
          <CheckBox x:Name="StartMenuBox" Style="{StaticResource Row}" Content="{x:Static loc:Strings.ShowInStartMenu}" Click="OnStartMenuClick" />
          <CheckBox x:Name="RecordBox" Style="{StaticResource Row}" Content="{x:Static loc:Strings.RecordClipboard}" Click="OnRecordClick" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:Strings.Language}" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="OnLanguageChanged" />
          </Grid>
          <TextBlock x:Name="LanguageNote" Style="{StaticResource Note}" Margin="0,4,0,0" Text="{x:Static loc:Strings.LanguageRestartNote}" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- Hotkey -->
      <TextBlock Style="{StaticResource Section}" Text="{x:Static loc:Strings.SectionHotkey}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" FontSize="14" Padding="8,5" Margin="0,0,8,0"
                     AutomationProperties.Name="{x:Static loc:Strings.HotkeyOpen}" PreviewKeyDown="OnHotkeyKeyDown" LostKeyboardFocus="OnHotkeyLostFocus" />
            <Button x:Name="HotkeyChange" Grid.Column="1" Content="{x:Static loc:Strings.HotkeyChange}" MinWidth="90" Margin="0,0,8,0" Click="OnHotkeyChange" />
            <Button Grid.Column="2" Content="{x:Static loc:Strings.HotkeyReset}" MinWidth="90" Click="OnHotkeyReset" />
          </Grid>
          <TextBlock x:Name="HotkeyNote" Style="{StaticResource Note}" Margin="2,8,0,0" />
        </StackPanel>
      </Border>

      <!-- History -->
      <TextBlock Style="{StaticResource Section}" Text="{x:Static loc:Strings.SectionHistory}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:Strings.MaxEntries}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox x:Name="MaxEntriesBox" Grid.Column="1" SelectionChanged="OnMaxEntriesChanged" />
          </Grid>
          <CheckBox x:Name="MemoryOnlyBox" Style="{StaticResource Row}" Content="{x:Static loc:Strings.MemoryOnly}" Click="OnMemoryOnlyClick" />
          <TextBlock Style="{StaticResource Note}" Text="{x:Static loc:Strings.MemoryOnlyNote}" />
          <Button Content="{x:Static loc:Strings.ClearHistoryButton}" HorizontalAlignment="Left" MinWidth="160" Click="OnClearHistory" />
        </StackPanel>
      </Border>

      <!-- Privacy -->
      <TextBlock Style="{StaticResource Section}" Text="{x:Static loc:Strings.SectionPrivacy}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox x:Name="SecretsBox" Style="{StaticResource Row}" Content="{x:Static loc:Strings.SkipSecrets}" Click="OnSecretsClick" />
          <TextBlock Style="{StaticResource Note}" Text="{x:Static loc:Strings.SkipSecretsNote}" />
          <CheckBox x:Name="CaptureBox" Style="{StaticResource Row}" Content="{x:Static loc:Strings.HideFromCapture}" Click="OnCaptureClick" />

          <TextBlock Text="{x:Static loc:Strings.ExcludedApps}" FontWeight="SemiBold" Margin="0,14,0,4" />
          <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8" Text="{x:Static loc:Strings.ExcludedAppsNote}" />
          <ListBox x:Name="ExcludedList" MinHeight="40" MaxHeight="160" Margin="0,0,0,8"
                   AutomationProperties.Name="{x:Static loc:Strings.ExcludedApps}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="12" Margin="12,0,0,0"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AddAppBox" IsEditable="True" Margin="0,0,8,0" ToolTip="{x:Static loc:Strings.AppNamePlaceholder}"
                      AutomationProperties.Name="{x:Static loc:Strings.AppNamePlaceholder}" />
            <Button Grid.Column="1" Content="{x:Static loc:Strings.AddApp}" MinWidth="90" Margin="0,0,8,0" Click="OnAddApp" />
            <Button Grid.Column="2" Content="{x:Static loc:Strings.RemoveApp}" MinWidth="90" Click="OnRemoveApp" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Appearance -->
      <TextBlock Style="{StaticResource Section}" Text="{x:Static loc:Strings.SectionAppearance}" />
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static loc:Strings.Theme}" VerticalAlignment="Center" />
          <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="OnThemeChanged" />
        </Grid>
      </Border>

      <!-- About -->
      <TextBlock Style="{StaticResource Section}" Text="{x:Static loc:Strings.SectionAbout}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Image x:Name="Logo" Width="36" Height="36" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.AppName}" FontWeight="SemiBold" />
              <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{x:Static loc:Strings.NoTelemetry}" TextWrapping="Wrap" Margin="0,0,0,6" />
          <TextBlock Text="{x:Static loc:Strings.License}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="Copyright © 2026 Secoolioo and contributors" FontSize="12" Margin="0,0,0,12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <WrapPanel>
            <Button Content="{x:Static loc:Strings.OpenDataFolder}" Margin="0,0,8,8" Click="OnOpenDataFolder" />
            <Button Content="{x:Static loc:Strings.ShowLicenses}" Margin="0,0,8,8" Click="OnLicenses" />
            <Button Content="{x:Static loc:Strings.ProjectPage}" Margin="0,0,8,8" Click="OnProjectPage" />
            <Button Content="{x:Static loc:Strings.SupportProject}" Margin="0,0,8,8" Click="OnSupport" />
          </WrapPanel>
          <Button Content="{x:Static loc:Strings.RemoveEverything}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnRemoveEverything" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
