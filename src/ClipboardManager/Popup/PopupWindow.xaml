<Window x:Class="ClipboardManager.Popup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardManager.Popup"
        xmlns:common="clr-namespace:ClipboardManager.Common"
        xmlns:loc="clr-namespace:ClipboardManager.Localization"
        x:ClassModifier="internal"
        Title="{x:Static loc:Strings.AppName}"
        Width="780" Height="480"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True"
        AutomationProperties.Name="{x:Static loc:Strings.PopupAutomationName}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <common:BoolToVisibilityConverter x:Key="VisibleIf" />
    <common:BoolToVisibilityConverter x:Key="CollapsedIf" Invert="True" />

    <Style x:Key="Kbd" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <DataTemplate DataType="{x:Type local:HeaderRow}">
      <TextBlock Text="{Binding Display}" FontSize="11" FontWeight="SemiBold" Margin="2,10,0,2"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:NoticeRow}">
      <Grid Margin="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14">
          <TextBlock.Foreground>
            <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
          </TextBlock.Foreground>
        </TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:MoreRow}">
      <TextBlock Text="{Binding Text}" Margin="28,0,0,0" Height="26" VerticalAlignment="Center" Padding="0,4,0,0"
                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:EntryRow}">
      <Grid Height="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   common:Highlight.Terms="{Binding Terms}" common:Highlight.Text="{Binding Preview}" />
        <TextBlock Grid.Column="2" Text="{Binding LineInfo}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                Visibility="{Binding IsCurrent, Converter={StaticResource VisibleIf}}">
          <TextBlock Text="{x:Static loc:Strings.CurrentBadge}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>
        <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="11.5" Margin="10,0,2,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsPinned}" Value="True">
          <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Search -->
      <Grid Margin="16,12,10,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="16" Margin="0,0,10,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Grid Grid.Column="1">
          <TextBox x:Name="Search" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="16" BorderThickness="0" Background="Transparent" Padding="2,6"
                   VerticalContentAlignment="Center"
                   AutomationProperties.Name="{x:Static loc:Strings.SearchPlaceholder}"
                   AutomationProperties.HelpText="{x:Static loc:Strings.SearchHelp}" />
          <TextBlock Text="{x:Static loc:Strings.SearchPlaceholder}" FontSize="16" Margin="6,0,0,0" IsHitTestVisible="False"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Visibility="{Binding Query, Converter={StaticResource CollapsedIf}}" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,6,0" VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding StatusText}">
          <TextBlock x:Name="ResultsLive" Text="{Binding ResultsText}" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding ResultsText, Converter={StaticResource VisibleIf}}" />
          <TextBlock x:Name="StatusGlyph" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" Text="&#xE73E;"
                     Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
          <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="3" Padding="8,6" Background="Transparent" BorderThickness="0"
                Focusable="False" Click="OnSettingsClick" AutomationProperties.Name="Settings">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14" />
        </Button>
      </Grid>

      <!-- Pause banner -->
      <Border Grid.Row="1" Margin="12,0,12,6" Padding="12,6" CornerRadius="6"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              Visibility="{Binding IsPaused, Converter={StaticResource VisibleIf}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Resume}" Click="OnResumeClick" Padding="12,3" />
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" FontSize="13" Margin="0,0,10,0"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}" />
          <TextBlock Text="{Binding PauseBanner}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- List + preview -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ListColumn" Width="400" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition x:Name="PreviewColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                 BorderThickness="0" Background="Transparent" Padding="6,0,4,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" KeyboardNavigation.TabNavigation="None"
                 AutomationProperties.Name="{x:Static loc:Strings.PopupAutomationName}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Padding" Value="6,0" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
              <Setter Property="AutomationProperties.PositionInSet" Value="{Binding Position}" />
              <Setter Property="AutomationProperties.SizeOfSet" Value="{Binding SetSize}" />
              <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnItemMouseUp" />
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemRightDown" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>

        <Border x:Name="Divider" Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <Grid x:Name="PreviewPane" Grid.Column="2" Margin="16,2,14,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <TextBlock x:Name="PreviewBlock" Text="{Binding PreviewText}" FontSize="13" LineHeight="19">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviewMonospace}" Value="True">
                      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
                      <Setter Property="TextWrapping" Value="NoWrap" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </ScrollViewer>
          <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.Truncated}" FontStyle="Italic" FontSize="11.5" Margin="0,8,0,0"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Visibility="{Binding PreviewTruncated, Converter={StaticResource VisibleIf}}" />
          <TextBlock Grid.Row="2" Text="{Binding PreviewMeta}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
      </Grid>

      <!-- Inline message -->
      <TextBlock x:Name="InlineMessageText" Grid.Row="3" Text="{Binding InlineMessage}" Margin="18,4,18,2" FontSize="12"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 AutomationProperties.LiveSetting="Assertive"
                 Visibility="{Binding InlineMessage, Converter={StaticResource VisibleIf}}" />

      <!-- Key hints -->
      <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="14,7">
        <WrapPanel x:Name="Hints" />
      </Border>
    </Grid>
  </Border>
</Window>
