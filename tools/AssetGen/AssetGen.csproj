<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool, never shipped: renders the app icon, README screenshots (real views with
       neutral demo data) and the donation QR code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1861;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" />
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClipboardManager\ClipboardManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
